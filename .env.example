# --- Mailbox --------------------------------------------------------------------
# Gmail address the agent works from (must match the authorised Google account).
AGENT_EMAIL=agent@yourcompany.com
# Who may email the agent (comma-separated, wildcards allowed). Registered users are always allowed.
ALLOWED_SENDERS=*@yourcompany.com

# --- Gmail push via Google Cloud Pub/Sub -----------------------------------------
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-agent
# Audience configured on the push subscription (usually the full push endpoint URL).
PUBSUB_AUDIENCE=https://agent.yourcompany.com/gmail/push
PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-gcp-project.iam.gserviceaccount.com
VERIFY_PUBSUB_JWT=true

# --- LLMs -------------------------------------------------------------------------
DEFAULT_MODEL=gemini-2.5-flash
# Optional model for routing only; gemini-3.1-flash-lite routed 90/90 eval emails correctly (evals/results/routing.md).
ROUTER_MODEL=
# Guardrails: hard timeout per LLM call / tool loop, reasoning-token cap for planning calls (Gemini 2.5).
LLM_TIMEOUT_S=120
PLANNING_THINKING_BUDGET=1024
# One or more Gemini keys; rotated automatically when a key hits its quota.
GEMINI_API_KEYS=key-1,key-2
# Optional paid key used only when all keys above are exhausted.
GEMINI_FALLBACK_API_KEY=
# Optional: enables `-model:grok-4` style overrides in the email subject.
XAI_API_KEY=

# --- App database (users, roles, workflow runs) ------------------------------------
APP_DATABASE_URL=sqlite+aiosqlite:///data/app.db
# APP_DATABASE_URL=mysql+aiomysql://user:password@db-host/email_agent

# --- Permissions ------------------------------------------------------------------
PERMISSIONS_ENABLED=true
# Role applied to allowed senders who are not registered users.
DEFAULT_USER_ROLE=guest
# Created as admin on first start.
ADMIN_EMAIL=you@yourcompany.com

# --- SQL databases the agent may query ---------------------------------------------
# JSON: name -> URL, or name -> {"url", "description", "read_only"}. Descriptions help routing.
# "notes" holds business definitions the schema cannot express; they are shown to the SQL planner.
# SQL_DATABASES={"crm": {"url": "mysql+aiomysql://ro_user:pw@crm-host/crm", "description": "Customers, deals and invoices", "notes": "Revenue = SUM(orders.amount)", "read_only": true}}
SQL_DATABASES={}

# --- Knowledge base (RAG) ------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
# SQL tables to embed (index with `python -m app.cli index sql`):
# RAG_SQL_TABLES=[{"database": "crm", "table": "articles", "text_columns": ["title", "body"], "title_column": "title", "date_column": "published_at"}]

# --- Google Drive sync ------------------------------------------------------------------
# Folders whose Docs / Sheets / PDFs are indexed and kept in sync via Drive push notifications.
DRIVE_FOLDER_IDS=
DRIVE_WEBHOOK_URL=https://agent.yourcompany.com/drive/push
DRIVE_CHANNEL_TOKEN=change-me-to-a-random-string

# --- Workflows ----------------------------------------------------------------------------
# Google Sheet with workflow definitions (see docs/workflows.md). Leave empty to disable.
WORKFLOW_SHEET_ID=
WORKFLOW_SHEET_TAB=Sheet1

# --- Finance specialist -------------------------------------------------------------------
FINANCE_ENABLED=true
# Optional: fundamentals, earnings and transcripts. Without it only Yahoo Finance news is used.
ALPHA_VANTAGE_API_KEY=
