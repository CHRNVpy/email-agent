# Demo configuration: copy to the project root as .env and fill in the three marked values.
# 1) The Gmail account the agent runs as
AGENT_EMAIL=your-demo-agent@gmail.com
# 2) The address you will send demo emails from
ALLOWED_SENDERS=your-personal@gmail.com
ADMIN_EMAIL=your-personal@gmail.com
# 3) Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEYS=your-gemini-key

DEFAULT_MODEL=gemini-2.5-flash
# Router on flash-lite: 90/90 correct in evals/results/routing.md, faster and 2.5x cheaper than 2.5-flash
ROUTER_MODEL=gemini-3.1-flash-lite
APP_DATABASE_URL=sqlite+aiosqlite:///data/app.db
PERMISSIONS_ENABLED=true

# Demo CRM created by `python -m demo.seed_crm`
SQL_DATABASES={"crm": {"url": "sqlite+aiosqlite:///data/demo/crm.db", "description": "CRM of Brightwave Labs: customers, orders, deals and invoices", "notes": "Revenue means SUM(orders.amount) by orders.order_date; invoices are billing documents, not revenue. An invoice is overdue when status = 'open' and due_date is before today; days overdue = today - due_date."}}

# Knowledge base: `python -m app.cli index files evals/corpus`
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=demo_kb

# Gmail push (see docs/google-setup.md). Leave empty to try everything with `python -m app.cli ask`.
GMAIL_PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=
VERIFY_PUBSUB_JWT=true
